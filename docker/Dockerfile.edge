# OpenChamber - latest source build from upstream main, variant tag :edge

FROM oven/bun:1.4.4 AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    git clone --depth=1 https://github.com/openchamber/openchamber.git . && \
    bun install --frozen-lockfile --ignore-scripts && \
    bun run build:web

# Same chmod-EPERM patch as Dockerfile.release: disable the three
# writeSettingsToDisk chmods in settings-runtime.js (build fails if the
# upstream pattern changes). The sed matches the guard with or without an
# extra condition (e.g. `created &&`) before `process.platform !== 'win32'`.
RUN SETTINGS_RUNTIME=packages/web/server/lib/opencode/settings-runtime.js && \
    sed -i -E "s/if \([^)]*process\.platform !== 'win32'\) await fsPromises\.chmod/if (false) await fsPromises.chmod/g" "$SETTINGS_RUNTIME" && \
    test "$(grep -c 'if (false) await fsPromises\.chmod' "$SETTINGS_RUNTIME")" -eq 3


FROM oven/bun:1.4.4

# Debian's nodejs is 20.x, older than the >=24.14.0 that @openchamber/web
# requires, so install Node from the official tarball instead.
# renovate: datasource=node-version depName=node
ARG NODE_VERSION=24.22.3

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git openssh-client && \
    rm -rf /var/lib/apt/lists/* && \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-$(uname -m | sed -e s/x86_64/x64/ -e s/aarch64/arm64/).tar.gz" | \
        tar -xz -C /usr/local --strip-components=1 --no-same-owner && \
    node --version && \
    userdel bun && \
    groupadd -g 1000 openchamber && \
    useradd -u 1000 -g 1000 -m -s /bin/bash openchamber

USER openchamber
WORKDIR /home/openchamber

ENV NPM_CONFIG_PREFIX=/home/openchamber/.npm-global
ENV PATH=/home/openchamber/.npm-global/bin:$PATH
ENV NODE_ENV=production
ENV OPENCHAMBER_HOST=0.0.0.0

RUN npm install -g opencode-ai

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/web/node_modules ./packages/web/node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/packages/web/package.json ./packages/web/package.json
COPY --from=builder /app/packages/web/bin ./packages/web/bin
COPY --from=builder /app/packages/web/server ./packages/web/server
COPY --from=builder /app/packages/web/dist ./packages/web/dist
COPY --from=builder /app/scripts/docker-entrypoint.sh /home/openchamber/openchamber-entrypoint.sh

EXPOSE 3000
ENTRYPOINT ["sh", "/home/openchamber/openchamber-entrypoint.sh"]
